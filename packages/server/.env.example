# Google OAuth client (Web application type) from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser reaches the app. In development this is the Vite dev server.
APP_URL=http://localhost:5173
# Where Google redirects after sign-in (this server). Defaults to APP_URL (Vite proxies /auth to the server in dev).
# SERVER_URL=http://localhost:8787

# Random string; keeps you signed in across server restarts.
SESSION_SECRET=

# Optional: restrict sign-in to these Google accounts (comma-separated).
ALLOWED_EMAILS=

# Optional: Web Push (lets the installed PWA receive nagging alerts while closed).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# PORT=8787
# DATA_DIR=../../data
